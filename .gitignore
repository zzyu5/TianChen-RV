__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/

build/
build/*/
build-ime-bridge/
cmake-build-*/
dist/
*.egg-info/

# parallel work-line infra (see docs/method/parallel-build-and-baseline.md):
#   .worktrees/<line>/        — per-line isolated worktree (branched from HEAD)
#   .worktrees/<line>/build/  — that line's independent CMakeCache
#   .worktrees/baseline-<sha> — detached base worktree for byte-exact (transient)
#   .worktrees/cache/<sha>/   — cached pinned-base build products (idempotent)
# All local, never committed. tools/bench/byte-exact-baseline.sh replaces the
# global `git stash` baseline so parallel lines are not clobbered.
.worktrees/

artifacts/tmp/
*.log


.claude/settings.local.json
/artifacts/p-a-fair-three-way/*/gen/
/artifacts/p-a-fair-three-way/*/harness.c
.claude/worktrees/

# on-device measurement raw artifacts (kernels/objs/logs) — data, not source
# (moved 2026-07-06 org STAGE1: experiments/ondevice-*/ -> experiments/archive/perf-historical/ondevice-*/)
experiments/archive/perf-historical/ondevice-*/

# gitignored diagnostic scratch (org STAGE1 target structure)
scratch/

# touch-set active-line marker — per-worktree, not shared (see .touch-set/README.md)
.touch-set/ACTIVE
