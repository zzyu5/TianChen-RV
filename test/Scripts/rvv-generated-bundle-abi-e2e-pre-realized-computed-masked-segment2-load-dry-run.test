# REQUIRES: weft-local-rvv-object-clang
# RUN: rm -rf %t.artifacts
# RUN: python3 %S/../../scripts/rvv_generated_bundle_abi_e2e.py --dry-run --pre-realized-selected-body --artifact-root %t.artifacts --run-id pre-realized-computed-mask-segment2-load --overwrite --op-kind computed_masked_segment2_load_unit_store --runtime-count 0 --runtime-count 1 --runtime-count 7 --runtime-count 16 --runtime-count 23 --runtime-count 257 --weft-opt weft-opt --weft-translate weft-translate --llvm-readobj llvm-readobj | FileCheck %s --check-prefix=STDOUT
# RUN: FileCheck %s --check-prefix=ROOT < %t.artifacts/pre-realized-computed-mask-segment2-load/evidence.json
# RUN: FileCheck %s --check-prefix=HARNESS --implicit-check-not="descriptor" --implicit-check-not="direct-C" --implicit-check-not="source-export" < %t.artifacts/pre-realized-computed-mask-segment2-load/computed_masked_segment2_load_unit_store/rvv_generated_bundle_abi_computed_masked_segment2_load_unit_store_harness.c

# STDOUT: rvv_generated_bundle_abi_e2e: dry_run_success
# STDOUT: artifact_dir:

# ROOT: "input_mode": "pre-realized-selected-body"
# ROOT: "computed_masked_segment2_load_unit_store"
# ROOT: "pre_realized_selected_body": true
# ROOT: "ssh_evidence": false
# ROOT: "status": "dry_run_success"

# CMSEG-DAG: "input_mode": "pre-realized-selected-body"
# CMSEG-DAG: "path": "{{.*}}test/Target/RVV/pre-realized-selected-body-artifact-computed-masked-segment2-load.mlir"
# CMSEG-DAG: "prototype": "void weft_emitc_pre_realized_body_cmseg_load_kernel_pre_realized_body_rvv_cmseg_load(const int32_t *cmp_lhs, const int32_t *cmp_rhs, const int32_t *src, int32_t *out0, int32_t *out1, size_t n);"
# CMSEG-DAG: "expected_function": "weft_emitc_pre_realized_body_cmseg_load_kernel_pre_realized_body_rvv_cmseg_load"
# CMSEG-DAG: "expected_runtime_abi_name": "rvv-exact-typed-body-callable-c-abi.v2"
# CMSEG-DAG: "expected_selected_variant": "pre_realized_body_rvv_cmseg_load"
# CMSEG-DAG: "front_door": "pre-realized-selected-weft-exec-rvv-body"
# CMSEG-DAG: "materializer": "weft-materialize-selected-lowering-boundaries"
# CMSEG-DAG: "route_entry_realization": false
# CMSEG-DAG: "selected_body_realization_producer": "rvv-plugin-local-selected-body-realization-owner-registry"
# CMSEG-DAG: --weft-materialize-selected-lowering-boundaries
# CMSEG-DAG: "pre_realized_body_consumed": true
# CMSEG-DAG: "memory_form": "computed-mask-segment2-load-unit-store"
# CMSEG-DAG: "mask_tail_policy_owner": "computed-mask memory mask/tail policy"
# CMSEG-DAG: "mask_coverage_contract": "multi-lane computed_masked_segment2_load_unit_store cases require compare-produced active and inactive mask lanes"
# CMSEG-DAG: "inactive_lane_contract": "compare-false lanes must preserve both old destination field passthrough vectors"
# CMSEG-DAG: "field_order_contract": "active lanes load distinguishable even/odd interleaved segment fields into out0/out1 while source and tail slots preserve sentinels"
# CMSEG-DAG: "status": "dry_run_success"

# HARNESS: weft_emitc_pre_realized_body_cmseg_load_kernel_pre_realized_body_rvv_cmseg_load(cmp_lhs, cmp_rhs, src, out0, out1, n);
# HARNESS: int32_t expected0 = active ? src[2 * index] : old0[index];
# HARNESS: int32_t expected1 = active ? src[2 * index + 1] : old1[index];
# HARNESS: inactive lane failed to preserve old fields
# HARNESS: pattern=%d ok computed_mask segment2_load
# HARNESS: field_distinguishing_lanes
# HARNESS: source_preserved tail_preserved
# HARNESS: for (int pattern = 0; pattern < 2; ++pattern)
# HARNESS: patterns=0,1
# HARNESS: PASS op=computed_masked_segment2_load_unit_store counts=0,1,7,16,23,257
