# REQUIRES: weft-local-rvv-object-clang
# RUN: rm -rf %t.artifacts
# RUN: python3 %S/../../scripts/rvv_generated_bundle_abi_e2e.py --dry-run --artifact-root %t.artifacts --run-id strided-add --overwrite --op-kind strided_add --runtime-count 7 --runtime-count 16 --runtime-count 23 --weft-opt weft-opt --weft-translate weft-translate --llvm-readobj llvm-readobj | FileCheck %s --check-prefix=STDOUT
# RUN: FileCheck %s --check-prefix=ROOT < %t.artifacts/strided-add/evidence.json
# RUN: FileCheck %s --check-prefix=HARNESS --implicit-check-not="descriptor" --implicit-check-not="direct-C" --implicit-check-not="source-export" < %t.artifacts/strided-add/strided_add/rvv_generated_bundle_abi_strided_add_harness.c

# STDOUT: rvv_generated_bundle_abi_e2e: dry_run_success
# STDOUT: artifact_dir:

# ROOT: "strided_add"
# ROOT: "ssh_evidence": false
# ROOT: "status": "dry_run_success"

# STRIDED-DAG: "input_mode": "explicit-selected-body"
# STRIDED-DAG: "path": "{{.*}}test/Target/RVV/explicit-selected-body-artifact-strided-add.mlir"
# STRIDED-DAG: "prototype": "void weft_emitc_explicit_selected_body_strided_add_kernel_explicit_selected_body_rvv_strided_add(const int32_t *lhs, const int32_t *rhs, int32_t *out, size_t n, size_t lhs_stride, size_t rhs_stride, size_t out_stride);"
# STRIDED-DAG: "expected_function": "weft_emitc_explicit_selected_body_strided_add_kernel_explicit_selected_body_rvv_strided_add"
# STRIDED-DAG: "expected_runtime_abi_name": "rvv-exact-typed-body-callable-c-abi.v2"
# STRIDED-DAG: "expected_selected_variant": "explicit_selected_body_rvv_strided_add"
# STRIDED-DAG: "lhs_stride": 2
# STRIDED-DAG: "rhs_stride": 3
# STRIDED-DAG: "out_stride": 2
# STRIDED-DAG: "lhs_stride": 3
# STRIDED-DAG: "rhs_stride": 2
# STRIDED-DAG: "out_stride": 4
# STRIDED-DAG: "stride_coverage_contract": "runtime strided_add cases must execute the same generated artifact with independent lhs/rhs/output element strides"
# STRIDED-DAG: "memory_form": "strided-load-store"
# STRIDED-DAG: "status": "dry_run_success"

# HARNESS: static int run_case(size_t n, size_t lhs_stride, size_t rhs_stride,
# HARNESS: weft_emitc_explicit_selected_body_strided_add_kernel_explicit_selected_body_rvv_strided_add(lhs, rhs, out, n, lhs_stride, rhs_stride, out_stride);
# HARNESS: int32_t expected = lhs[index * lhs_stride] + rhs[index * rhs_stride];
# HARNESS: size_t out_index = index * out_stride;
# HARNESS: source_gaps_preserved output_gaps_preserved tail_preserved
# HARNESS: stride_cases
# HARNESS-SAME: 2, 3, 2
# HARNESS-SAME: 3, 2, 4
# HARNESS: stride_triples=2:3:2,3:2:4
