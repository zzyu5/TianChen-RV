# RUN: rg -n 'getConstructionEntryNames\(\) const override' %S/../../lib/Plugin/Template/TemplateBackendEmissionDriver.cpp | FileCheck %s --check-prefix=TEMPLATE
# RUN: rg -n 'getConstructionEntryNames\(\) const override' %S/../../lib/Plugin/TensorExtLite/EmitC/TensorExtLiteBackendEmissionDriver.cpp | FileCheck %s --check-prefix=TENSOR
