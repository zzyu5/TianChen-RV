# Every production backend must name and execute a family-local construction
# entry.  The shared interface deliberately has no implicit success path.
# RUN: rg -n 'prepareForConversion\(mlir::ModuleOp module\) const = 0' %S/../../include/Weft/Conversion/EmitC/TypedBackendEmissionDriver.h | FileCheck %s --check-prefix=PURE
# RUN: not rg -n 'prepareForConversion\(mlir::ModuleOp module\) const \{' %S/../../include/Weft/Conversion/EmitC/TypedBackendEmissionDriver.h
