# RUN: rg -n 'return constructDemoFinalBody\(module\)' %S/../../lib/Plugin/Demo/DemoBackendEmissionDriver.cpp | FileCheck %s --check-prefix=DEMO-CALL
# RUN: rg -n 'return constructIMEFinalPlans\(module\)' %S/../../lib/Plugin/IME/IMEBackendEmissionDriver.cpp | FileCheck %s --check-prefix=IME-CALL
# RUN: rg -n 'return constructScalarFinalPlans\(module\)' %S/../../lib/Plugin/Scalar/ScalarBackendEmissionDriver.cpp | FileCheck %s --check-prefix=SCALAR-CALL
# RUN: rg -n 'return constructToyFinalBody\(module\)' %S/../../lib/Plugin/Toy/ToyBackendEmissionDriver.cpp | FileCheck %s --check-prefix=TOY-CALL
