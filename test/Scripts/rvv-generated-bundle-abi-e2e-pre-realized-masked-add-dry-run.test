# REQUIRES: weft-local-rvv-object-clang
# RUN: rm -rf %t.artifacts
# RUN: python3 %S/../../scripts/rvv_generated_bundle_abi_e2e.py --dry-run --pre-realized-selected-body --artifact-root %t.artifacts --run-id pre-realized-masked-add --overwrite --op-kind masked_add --runtime-count 0 --runtime-count 7 --runtime-count 16 --runtime-count 23 --runtime-count 257 --weft-opt weft-opt --weft-translate weft-translate --llvm-readobj llvm-readobj | FileCheck %s --check-prefix=STDOUT
# RUN: FileCheck %s --check-prefix=ROOT < %t.artifacts/pre-realized-masked-add/evidence.json
# RUN: FileCheck %s --check-prefix=HARNESS --implicit-check-not="descriptor" --implicit-check-not="direct-C" --implicit-check-not="source-export" < %t.artifacts/pre-realized-masked-add/masked_add/rvv_generated_bundle_abi_masked_add_harness.c

# STDOUT: rvv_generated_bundle_abi_e2e: dry_run_success
# STDOUT: artifact_dir:

# ROOT: "input_mode": "pre-realized-selected-body"
# ROOT: "masked_add"
# ROOT: "pre_realized_selected_body": true
# ROOT: "ssh_evidence": false
# ROOT: "status": "dry_run_success"

# MASKED-DAG: "input_mode": "pre-realized-selected-body"
# MASKED-DAG: "path": "{{.*}}test/Target/RVV/pre-realized-selected-body-artifact-masked-add.mlir"
# MASKED-DAG: "prototype": "void weft_emitc_pre_realized_body_masked_add_kernel_pre_realized_body_rvv_masked_add(const int32_t *lhs, const int32_t *rhs, int32_t *out, size_t n);"
# MASKED-DAG: "expected_function": "weft_emitc_pre_realized_body_masked_add_kernel_pre_realized_body_rvv_masked_add"
# MASKED-DAG: "expected_runtime_abi_name": "rvv-exact-typed-body-callable-c-abi.v2"
# MASKED-DAG: "expected_selected_variant": "pre_realized_body_rvv_masked_add"
# MASKED-DAG: "front_door": "pre-realized-selected-weft-exec-rvv-body"
# MASKED-DAG: "materializer": "weft-materialize-selected-lowering-boundaries"
# MASKED-DAG: --weft-materialize-selected-lowering-boundaries
# MASKED-DAG: "pre_realized_body_consumed": true
# MASKED-DAG: "memory_form": "vector-rhs-load"
# MASKED-DAG: "mask_tail_policy_boundary":
# MASKED-DAG: "active_compute_intrinsic": "__riscv_vadd_vv_i32m1"
# MASKED-DAG: "masked_merge_intrinsic": "__riscv_vmerge_vvm_i32m1"
# MASKED-DAG: "runtime_counts_are_execution_cases_not_policy_authority": true
# MASKED-DAG: "inactive_lane_contract": "masked-off lanes must preserve the explicit passthrough vector"
# MASKED-DAG: "mask_coverage_contract": "multi-lane masked elementwise cases require true and false mask lanes"
# MASKED-DAG: "status": "dry_run_success"

# HARNESS: weft_emitc_pre_realized_body_masked_add_kernel_pre_realized_body_rvv_masked_add(lhs, rhs, out, n);
# HARNESS: (lhs[index] == rhs[index] ? (int32_t)(lhs[index] + rhs[index]) : lhs[index])
# HARNESS: mask_true_lanes
# HARNESS: mask_false_lanes
# HARNESS: passthrough_preserved_lanes
# HARNESS: const size_t counts[] = {0, 7, 16, 23, 257};
