        // expected-error @+1 {{currently supports only kind "ggml_repack_gemv_tq2_0_q8_K"}}
        %g = tcrv_rvv.repack_gemv_tq2_0_q8_K %vx, %vy, %s, %n, %nc, %vl {kind = "gemv", scale_model = "superblock-d.fp16-single-scale-2bit-ternary-nomin", qk = 256 : i64, weight_block_stride = 1056 : i64, activation_block_stride = 292 : i64, weight_quant_byte_offset = 32 : i64, activation_quant_byte_offset = 4 : i64, weight_interleave = 16 : i64, half_lanes = 8 : i64} : !tcrv_rvv.runtime_abi_value, !tcrv_rvv.runtime_abi_value, !tcrv_rvv.runtime_abi_value, index, index, !tcrv_rvv.vl -> !tcrv_rvv.vector<i32, "m1">
      } : !tcrv_rvv.vl
    }
  }
}

