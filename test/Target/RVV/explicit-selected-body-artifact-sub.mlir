// PLAN-SAME: runtime_abi_name = "rvv-exact-typed-body-callable-c-abi.v2"
// PLAN-SAME: status = "supported"
// PLAN-SAME: target = @explicit_selected_body_rvv_i32_sub

// HEADER: weft.rvv.selected_variant: @explicit_selected_body_rvv_i32_sub
// HEADER: weft.rvv.runtime_abi_name: rvv-exact-typed-body-callable-c-abi.v2
// HEADER: void weft_emitc_explicit_selected_body_sub_kernel_explicit_selected_body_rvv_i32_sub(const int32_t *lhs, const int32_t *rhs, int32_t *out, size_t n);
