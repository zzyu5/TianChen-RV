def guarded_open(path, mode):
    """§3.2.2 测量禁止创建三处目的地以外的任何文件。写路径不在闸内 = 中止，不是警告。

    三目的地（§3.2.1·ISSUE-073 已 RESOLVED）：experiments/master/ · runs/<run-id>/ · runs.log。
    旧址 experiments/active/result-tables/（已迁出）与任何散件路径 = 闸外，仍拒。
    """
    real = os.path.realpath(path)
    allowed = (
        real == os.path.realpath(DEST_RUNSLOG)
        or real.startswith(os.path.realpath(DEST_RUNS) + os.sep)
        or real.startswith(os.path.realpath(DEST_MASTER) + os.sep)
    )
    if not allowed:
        raise SystemExit(
            f"[destination-guard] 拒绝写入 {real}\n"
            f"  §3.2 单一目的地法只许三处：\n"
            f"    {DEST_MASTER}/ · {DEST_RUNS}/<run-id>/ · {DEST_RUNSLOG}\n"
            f"  （旧址 {MASTER_INTERIM} 已迁出【README-MOVED】，闸外，拒。）"
        )
    return open(real, mode, encoding="utf-8")


