    """对拍（一步三验）：我方 vs oracle · 对手 vs oracle · 对手就是真实派发的那一个。

    execute：调 cells/ harness verify → 解析 ABI-GATE / T2 三验 / 4-arm anti-hollow /
    我方向量指令数 / 部署派发身份 + 档。任一失败落对应 VOID（不计时）。
    """
    plan = {
        "步": "3 · 对拍（硬点：一步三验）",
        "验 ①": f"我方 vs oracle（[K-5] 整数 byte-exact / 浮点 ULP 上界）→ 失败 = {VOID_OURS_WRONG}",
        "验 ②": f"对手 vs oracle（同一 oracle）→ 失败 = {VOID_OPP_BAD}（禁用坏对手时间算倍率）",
        "验 ③": f"对手 = 该板 ggml 实际部署派发的函数（objdump dispatch/类型注册表）→ 不符 = {VOID_DISPATCH_MISMATCH}",
        "向量指令数": "objdump -d 我方 .o，TAB-field-aware awk 计 $3~/^v/ 且剔除 ^vset（配置指令）与死值；记录不拦截",
        "对手档": "{手调 | 通用向量 | 标量类} 逐格证据判定（§3.4），证据引用入行",
        "任一失败": "不计时",
    }
    if not execute:
        return plan, None

    harness = cell_harness(op)
    rc, text = _run_harness(harness, board, "verify", fmt, HARNESS_TIMEOUT_VERIFY)
    if run_dir is not None:
        with guarded_open(os.path.join(run_dir, "verify.stdout.txt"), "w") as fh:
            fh.write(text)
    if rc is None:
        return plan, f"{VOID_OURS_WRONG}(verify harness 超时)"
    if rc != 0:
        # 板端硬失败（build/probe VOID）——归我方错，除非 stdout 明说对手废/派发不符。
        return plan, f"{VOID_OURS_WRONG}(verify harness rc={rc})"
    if "# ALL_DONE" not in text:
        return plan, f"{VOID_OURS_WRONG}(verify 未跑完·无 ALL_DONE)"
    if _cpu_md5_stable(text) is False:
        return plan, f"{VOID_DIRTY_BOARD}(对手库 md5 测量中变身)"

    sec = _split_sections(text)
    # 干净段 [A]（T1 exact shape）+ [E]（T2 measure shape）—— 三验须全过。
    clean = sec.get("A", []) + sec.get("E", [])
    ours = _mism(clean, "T2 ours")
    oppg = _mism(clean, "T2 OPP-G")
    oppx = _mism(clean, "T2 OPP-X")
    t1 = _mism(sec.get("A", []), "T1 BOARD-BYTE-EXACT")
    if "-> PASS" not in "\n".join(l for l in clean if "ABI-GATE" in l):
        return plan, f"{VOID_OURS_WRONG}(ABI-GATE 非 PASS)"
    if ours is None or oppx is None or oppg is None or t1 is None:
        return plan, f"{VOID_OURS_WRONG}(对拍三验解析不出 mism)"
    if t1 != 0 or ours != 0:
        return plan, f"{VOID_OURS_WRONG}(我方 vs oracle mism T1={t1} T2={ours})"
    if oppx != 0:
        return plan, f"{VOID_OPP_BAD}(部署对手 OPP-X vs oracle mism={oppx})"
    if oppg != 0:
        return plan, f"{VOID_OPP_BAD}(参照对手 OPP-G vs oracle mism={oppg})"

    # 4-arm anti-hollow：[B] 全 RED（三 GATE FAIL）· [C]/[D] 仅 OURS RED（gate 咬到发射的 RISC-V）。
    def _gate(letter, who):
        for ln in sec.get(letter, []):
            if "GATE-" in ln and "=" in ln:
                m = re.search(who + r"\s*=\s*(PASS|FAIL)", ln)
                if m:
                    return m.group(1)
        return None
    if _gate("B", "GATE-OURS") != "FAIL":
        return plan, f"{VOID_OURS_WRONG}(anti-hollow[B] oracle-fault 未被 gate 咬)"
    if _gate("C", "GATE-OURS") != "FAIL" or _gate("C", "GATE-OPPX") != "PASS":
        return plan, f"{VOID_OURS_WRONG}(anti-hollow[C] DUT-fault gate 空心)"
    if _gate("D", "GATE-OURS") != "FAIL" or _gate("D", "GATE-OPPX") != "PASS":
        return plan, f"{VOID_OURS_WRONG}(anti-hollow[D] leaf-byte-fault gate 空心)"

    # 验③：部署派发 —— dispatch thunk PRESENT + 该板 _vlNNN PRESENT。
    opp = _parse_opp(text)
    thunk = f"ggml_vec_dot_{fmt}_q8_K"
    vltag = "vl128" if board == "rvv" else "vl256"
    vlsym = f"{thunk}_{vltag}"
    if not opp.get(thunk, {}).get("present"):
        return plan, f"{VOID_DISPATCH_MISMATCH}(派发 thunk {thunk} ABSENT)"
    deployed = opp.get(vlsym)
    if deployed is None or not deployed.get("present"):
        return plan, f"{VOID_DISPATCH_MISMATCH}(部署核 {vlsym} ABSENT)"

    ours_leaf = _parse_ours_leaf(text)
    result = {
        "opp_sym": f"{thunk}(→{vltag}·CROSSOP)",
        "opp_caliber": _opp_caliber(deployed),
        "opp_evidence": (
            f"objdump dispatch: {vlsym}@{deployed['addr']} "
            f"rvv{deployed['rvv']}/vset{deployed['vset']}/gather{deployed['gather']}"
        ),
        "our_vector_ex_vset": (ours_leaf or {}).get("vector_ex_vset"),
        "our_leaf": ours_leaf,
    }
    return plan, result


_GEMM_PREFILL_RE = re.compile(
    r"GEMM_PREFILL fmt=(\S+) .* seed=0x([0-9A-Fa-f]+) \| "
    r"ours_med_ns=(\d+)\(iqr[\d.]+%\) oppG_med_ns=(\d+)\(iqr[\d.]+%\) "
    r"oppX_med_ns=(\d+)\(iqr[\d.]+%\) \| ratio_cold_G=([\d.]+) ratio_cold_X=([\d.]+)"
)


def step4_cold(fmt, board, cfg, execute, op=None, run_dir=None):
    """cold 计时：预注册重复数，冷启动唯一。ratio_cold_X = 我方 vs 部署对手（头条）。"""
    plan = {
        "步": "4 · cold 计时",
        "预注册": "重复数 N 先于测量预注册（§3.6 预注册先于测量）",
        "冷启动唯一": f"每 rep 前 flush {cfg['flush_mb']} MiB（> 该板 LLC）· taskset -c <best-core>",
        "禁继承": "§3.6：decode 一律 M=1 实测；IME 禁承 native",
        "近门": f"仅当比值 ∈ [{NEAR_GATE_LO}, {NEAR_GATE_HI}] 追加一次独立复测确认 → 打噪声标",
    }
    if not execute:
        return plan, None

    harness = cell_harness(op)
    rc, text = _run_harness(harness, board, "measure", fmt, HARNESS_TIMEOUT_MEASURE)
    if run_dir is not None:
        with guarded_open(os.path.join(run_dir, "measure.stdout.txt"), "w") as fh:
            fh.write(text)
    if rc is None:
        return plan, f"{VOID_DIRTY_BOARD}(measure harness 超时)"
    if "# VOID-LOAD" in text:
        return plan, f"{VOID_DIRTY_BOARD}(measure 载荷门未过)"
    if rc != 0 or "# ALL_DONE" not in text:
        return plan, f"{VOID_DIRTY_BOARD}(measure harness rc={rc} 未跑完)"
    if _cpu_md5_stable(text) is False:
        return plan, f"{VOID_DIRTY_BOARD}(对手库 md5 测量中变身)"

    seeds = []
    for m in _GEMM_PREFILL_RE.finditer(text):
        seeds.append({
            "seed": "0x" + m.group(2),
            "ours_med_ns": int(m.group(3)),
            "oppX_med_ns": int(m.group(5)),
            "ratio_cold_G": float(m.group(6)),
            "ratio_cold_X": float(m.group(7)),
        })
    if not seeds:
        return plan, f"{VOID_DIRTY_BOARD}(measure 解析不出 GEMM_PREFILL 行)"

    cold_x = seeds[0]["ratio_cold_X"]         # 主表落 s1（与 P2 seal 口径一致）
    near = is_near_gate(cold_x)
    noise = ""
    if near and len(seeds) >= 2:
        spread = abs(seeds[0]["ratio_cold_X"] - seeds[1]["ratio_cold_X"])
        noise = f"近门·2seed一致(Δ={spread:.4f})" if spread < 0.05 else f"近门·2seed分散(Δ={spread:.4f})"
    result = {
        "cold": f"{cold_x:.4f}",
        "cold_x_s1": cold_x,
        "seeds": seeds,
        "near_gate": near,
        "noise": noise,
    }
    return plan, result


def classify_verdict(cold):
    """ratio_cold = 部署对手时间 / 我方时间。>1 我方快=WIN；[0.7,1) 近门；<0.7 明输。"""
    if cold >= 1.0:
        return "WIN"
    if cold >= NEAR_GATE_LO:
        return "near-parity"
    return "LOSS"


def assemble_row(op, fmt, engine, regime, r3, r4, lineage, run_id):
    """按 §3.3.1 narrow schema 组行。数字全来自 harness stdout 解析，零手算。"""
    cold_x = r4["cold_x_s1"]
