_SECTION_RE = re.compile(r"^=== \[([A-E])\]")


def _split_sections(text):
    sections, cur = {"pre": []}, "pre"
    for ln in text.splitlines():
        m = _SECTION_RE.match(ln)
        if m:
            cur = m.group(1)
            sections[cur] = []
        sections.setdefault(cur, []).append(ln)
    return sections


def _mism(lines, needle):
    for ln in lines:
        if needle in ln:
            m = re.search(r"mism=(\d+)/(\d+)", ln)
            if m:
                return int(m.group(1))
    return None


def _parse_ours_leaf(text):
    m = re.search(r"# OURS_leaf \[ins=(\d+) rvv=(\d+) gather=(\d+) vset=(\d+)\]", text)
    if not m:
        return None
    ins, rvv, gat, vs = map(int, m.groups())
    return {"ins": ins, "rvv": rvv, "gather": gat, "vset": vs, "vector_ex_vset": rvv - vs}


def _parse_opp(text):
    entries = {}
    for ln in text.splitlines():
        m = re.match(
            r"# OPP (\S+) (PRESENT|ABSENT) @(\S*) m1\[ins=(\d+) rvv=(\d+) gather=(\d+) vset=(\d+)\]",
            ln,
        )
        if m:
            entries[m.group(1)] = {
                "present": m.group(2) == "PRESENT",
                "addr": m.group(3),
                "ins": int(m.group(4)),
                "rvv": int(m.group(5)),
                "gather": int(m.group(6)),
                "vset": int(m.group(7)),
            }
    return entries


def _cpu_md5_stable(text):
    """静板续证：libggml-cpu.so 运行前后 md5 一致（对手库未在测量中变身）。"""
    before = re.search(r"# cpu_md5_before=([0-9a-f]+)", text)
    after = re.search(r"# cpu_md5_after=([0-9a-f]+)", text)
    if not before or not after:
        return None
    return before.group(1) == after.group(1)


def _opp_caliber(deployed):
