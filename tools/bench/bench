def update_master_cell(op, fmt, engine, regime, board, cold_value):
    """§3.0 一次测量 = 主表一行受控更新。行键 (op,format,engine,regime)；只改 {board}_cold 一格。

    line-based 外科式：仅重写被命中的那一行（csv 往返只作用于它），其余行逐字节保留。
    命中值与旧值相等（4 位小数）时【不落盘】——新旧通道产同一个数 ⟹ 主表字节不变。
    返回 (status, old, new, lineno)；无命中行返回 ("no-row", None, None, None)。
    """
    with open(MASTER_TABLE, encoding="utf-8", newline="") as fh:
        text = fh.read()
    lines = text.split("\n")
    header = next(csv.reader([lines[0]]))
    col = f"{board}_cold"
    if col not in header:
        raise SchemaDrift(f"主表无列 {col}（{os.path.relpath(MASTER_TABLE, ROOT)}）")
    cidx = header.index(col)
    kidx = {h: header.index(h) for h in ("op", "format", "engine", "regime")}
    new_str = f"{cold_value:.4f}"
    for i in range(1, len(lines)):
        if not lines[i].strip():
            continue
        fields = next(csv.reader([lines[i]]))
        if len(fields) < len(header):
            continue
        rk = fields[kidx["regime"]]
        if (
            fields[kidx["op"]] == op
            and fields[kidx["format"]] == fmt
            and fields[kidx["engine"]] == engine
            and (rk == regime or rk == "")     # 主表 regime 常空（数据 finding·见报告）
        ):
            old = fields[cidx]
            if old == new_str:
                return "unchanged", old, new_str, i + 1
            fields[cidx] = new_str
            buf = io.StringIO()
            csv.writer(buf, lineterminator="").writerow(fields)
            lines[i] = buf.getvalue()
            with guarded_open(MASTER_TABLE, "w") as fh:
                fh.write("\n".join(lines))
            return "updated", old, new_str, i + 1
    return "no-row", None, None, None


def step5_row(run_id, execute, row=None, board=None, run_dir=None):
    """入行：按 §3.3.1 字段表写一行 + 受控更新主表 {board}_cold 一格。"""
    plan = {
        "步": "5 · 入行",
        "字段": " / ".join(ROW_SCHEMA),
        "目的地": f"主表（现址 {os.path.relpath(MASTER_TABLE, ROOT)}·ISSUE-073 已 RESOLVED）",
        "VOID": "VOID 的行不存在 —— 只在 runs.log 留一行，不入主表",
    }
    if not execute:
        return plan, None

    header, values = render_row(row)
    with guarded_open(os.path.join(run_dir, "row.csv"), "w") as fh:
        fh.write(header + "\n" + values + "\n")
    status = update_master_cell(
        row["op"], row["format"], row["engine"], row["regime"], board, float(row["cold"]),
    )
    return plan, {"master": status, "row": row}


# ───────────────────────────────────────────────────────── 演示行（0 造数）
def dry_run_row(run_id, fmt):
    """干跑演示行：除 run-id 与 format（= 入参回显）外每个字段都显式标 DRY-RUN。

    行键四元（§3.3.1）里只有 `format` 是 `bench <格>` 真给的；`op` / `engine` / `regime`
    **干跑不填** —— 一个格跨多 op，且 `--board` 推不出 `engine`（k1 上可为 rvv|ime）。
    命令签名要不要带全行键 = ISSUE-091 未裁的那一半 ⟹ 保守默认【不选行、不猜键】。
    """
    return {
        # 三个占位刻意【不含数字】：0 造数检查覆盖全体非 run-id 字段，含行键（连"ISSUE-〇九一"
        # 这样的编号都会被它咬 —— 故此处以「命令签名未裁」指代，编号写在 spec 与 docstring 里）。
        "op": f"{DRY_RUN_MARK}(未定位·roster 命中多 op·命令签名未裁)",
        "format": fmt,
        "engine": f"{DRY_RUN_MARK}(未定位·板推不出 engine·命令签名未裁)",
        "regime": f"{DRY_RUN_MARK}(未定位·命令签名未裁)",
        "cold": f"{DRY_RUN_MARK}(未计时)",
        "判定": f"{DRY_RUN_MARK}(未判定)",
        "对手符号": f"{DRY_RUN_MARK}(未探针)",
        "对手档": f"{DRY_RUN_MARK}(未判档)",
        "对手证据引用": f"{DRY_RUN_MARK}(无证据)",
        "我方向量指令数": f"{DRY_RUN_MARK}(未计数)",
        "世系": f"{DRY_RUN_MARK}(未探针)",
        "run-id": run_id,
        "噪声标": f"{DRY_RUN_MARK}(未评估)",
    }


def render_row(row):
    header = ",".join(ROW_SCHEMA)
    values = ",".join(row[f] for f in ROW_SCHEMA)
    return header, values


# ───────────────────────────────────────────────────────── 自检（纯函数 · 不碰板 · 不写盘）
def self_test():
    ok = []

    assert_schema_bound()
    ok.append(f"schema 绑定：runner {len(ROW_SCHEMA)} 字段 == spec §3.3.1 字段表 {spec_row_schema()}")

    # 行键四元（§3.3.1 前 4 字段）—— 三元组口径已作废，四元组才唯一定位物理行。
    assert spec_row_schema()[:4] == ROW_KEY, f"spec 行键前四字段 != {ROW_KEY}"
    ok.append(f"行键 == {ROW_KEY} 四元组（spec §3.3.1 机核 · 三元组口径作废）")

    # 入参回显 sentinel：刻意【不含数字】，使下面的 0 造数检查对全体非 run-id 字段保持满强度。
    row = dry_run_row("RID", "FMT-SENTINEL")
    assert tuple(row) == ROW_SCHEMA, "演示行字段序与 ROW_SCHEMA 不一致"
    ok.append("演示行字段序 == ROW_SCHEMA（逐项一一对应，不增不删）")

    assert row["format"] == "FMT-SENTINEL", "format 非入参回显（被改写 = 造键嫌疑）"
    assert all(row[k].startswith(DRY_RUN_MARK) for k in ("op", "engine", "regime")), \
        "干跑填了 op/engine/regime（= 猜行键；ISSUE-091 保守默认 = 不选行、不猜键）"
    ok.append("行键：format = 入参回显不改写 · op/engine/regime 干跑不猜（ISSUE-091 保守默认）")

    # 0 造数：除 run-id 外，演示行不得含任何数字（format 走 sentinel ⟹ 覆盖面不缩）。
    digits = {k: v for k, v in row.items() if k != "run-id" and re.search(r"\d", v)}
    assert not digits, f"演示行含数字（造数嫌疑）：{digits}"
    ok.append("0 造数：演示行除 run-id 外零数字")

    # 目的地闸真的会咬（负控）：散件 + 旧址（result-tables，已迁出）全拒。
    for bad in (os.path.join(ROOT, "experiments", "stray.txt"),
                os.path.join(MASTER_INTERIM, "T3_master_rebuild.csv"),
                os.path.join(ROOT, "tools", "bench", "cells", "leak.csv")):
        try:
            guarded_open(bad, "a")
        except SystemExit:
            pass
        else:
            raise AssertionError(f"目的地闸未咬：{bad}")
    ok.append("目的地闸负控：闸外路径（experiments/ 散件 · 旧址 result-tables/ · tools/ 下落数据）全部被拒")

    # 正控：三目的地放行（master/ 已随 ISSUE-073 RESOLVED 就位）。
    for good in (DEST_RUNSLOG, os.path.join(DEST_RUNS, "RID", "x.log"), MASTER_TABLE):
        real = os.path.realpath(good)
        allowed = (
            real == os.path.realpath(DEST_RUNSLOG)
            or real.startswith(os.path.realpath(DEST_RUNS) + os.sep)
            or real.startswith(os.path.realpath(DEST_MASTER) + os.sep)
        )
        assert allowed, f"目的地闸误咬合法路径：{good}"
    ok.append("目的地闸正控：runs.log · runs/<run-id>/ · master/（ISSUE-073 已 RESOLVED）放行")

    assert is_near_gate(0.85) and is_near_gate(0.7) and is_near_gate(1.0)
    assert not is_near_gate(0.69) and not is_near_gate(1.01)
    ok.append(f"近门区间 [{NEAR_GATE_LO}, {NEAR_GATE_HI}] 闭区间判定（含端点）")

    assert len(VOID_REASONS) == 4, "VOID 出口数与 §3.3 不符"
    ok.append(f"VOID 四出口：{' / '.join(VOID_REASONS)}")

    rid = make_run_id("q4_0", "rvv")
    assert re.match(r"^\d{8}T\d{6}Z-q4_0-rvv-[0-9a-f]{8}$", rid), rid
    ok.append("run-id 形态 <UTC>-<格>-<板>-<8hex>（板经 run-id 编码 ⟹ 台账不增字段）")

    assert set(BOARDS) == {"rvv", "k1", "scalar", "rvv07"}, "板册与 §3.1 四板不符"
    assert not BOARDS["scalar"]["measurable"] and not BOARDS["rvv07"]["measurable"]
    ok.append("板册 == §3.1 四板；scalar（ISSUE-061）与 rvv07（ISSUE-063）真实模式不开测")

    for line in ok:
        print(f"  PASS  {line}")
    print(f"\n[self-test] {len(ok)}/{len(ok)} PASS")
    return 0


# ───────────────────────────────────────────────────────── main
def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="bench",
        description="唯一合法测量动作（.trellis/spec/measurement §3.3）。本层是权威，本 runner 是实现。",
    )
    # 行键四元组（§3.3.1）：真跑经命令携全键定位物理行。干跑向后兼容单 positional（= format）。
    ap.add_argument("op", nargs="?", help="算子 op，如 gemm_tile（干跑可省，只给 format）")
    ap.add_argument("format", nargs="?", help="量化格式 format，如 iq3_xxs")
    ap.add_argument("--board", help="板：" + " | ".join(BOARDS))
    ap.add_argument("--engine", help="引擎 engine：rvv | ime（真跑须给·行键分量）")
    ap.add_argument("--regime", help="相 regime：prefill | decode（真跑须给·行键分量）")
    ap.add_argument("--dry-run", action="store_true",
                    help="干跑演示：零 ssh · 零计时 · 零主表写；只产 runs.log 一行 + 演示行")
    ap.add_argument("--self-test", action="store_true", help="纯函数自检（不碰板、不写盘）")
    args = ap.parse_args(argv)

    if args.self_test:
        return self_test()

    op, fmt = args.op, args.format
    board, engine, regime = args.board, args.engine, args.regime
    execute = not args.dry_run

    # 向后兼容：单 positional 且是已知 format ⟹ 视作 format（op 未定，仅干跑演示合法）。
    if fmt is None and op is not None and op in known_formats():
        fmt, op = op, None

    if not fmt or not board:
        ap.error("用法（真跑）：bench <op> <format> --board <板> --engine <e> --regime <r>\n"
                 "         （干跑）：bench <format> --board <板> --dry-run")
    if board not in BOARDS:
        ap.error(f"未知板 {board}（§3.1 板册只钉死四板：{' / '.join(BOARDS)}）")

    # schema 绑定先于一切（spec 漂移 = runner 缺陷，当场红）。
    assert_schema_bound()

    cfg = BOARDS[board]
    rows = roster_rows(fmt)
    if not rows:
        ap.error(f"格 {fmt} 不在 roster（{os.path.relpath(ROSTER, ROOT)}）。已知格：{' '.join(known_formats())}")

    run_id = make_run_id(fmt, board)

    print(f"bench {op or ''} {fmt} --board {board}"
          + (f" --engine {engine}" if engine else "")
          + (f" --regime {regime}" if regime else "")
          + ("" if execute else "  --dry-run"))
    print(f"  run-id  = {run_id}")
    print(f"  板      = {cfg['identity']} · {cfg['vector']} · {cfg['pmu']}")
    print(f"  格      = {fmt} —— roster 命中 {len(rows)} 条 op：{' '.join(r['op'] for r in rows)}")

    # ── 干跑演示（ISSUE-091 保守默认：不选行、不猜键、不写主表）────────────────────
    if not execute:
        if len(rows) > 1:
            print("            ★ 干跑不定位行 —— 行键 = (op, format, engine, regime) 四元组（§3.3.1）；")
            print("              演示只回显 format，op/engine/regime 一律标 DRY-RUN。")
        print()
        print("  ── 五步流水线（干跑：只述不做）─────────────────────────")
        for plan, _ in (
            step1_preflight(board, cfg, False),
            step2_lineage(board, cfg, False),
            step3_crosscheck(fmt, board, cfg, False),
            step4_cold(fmt, board, cfg, False),
            step5_row(run_id, False),
        ):
            print(f"  [{plan['步']}]")
            for k, v in plan.items():
                if k != "步":
                    print(f"      {k:<12}{v}")
        print()
        header, values = render_row(dry_run_row(run_id, fmt))
        print(f"  ── 演示行（§3.3.1 {len(ROW_SCHEMA)} 字段 · 逐字对齐 spec · 零正式数字）──")
        print(f"  {header}")
        print(f"  {values}")
        print()
        line = append_runs_log(run_id, fmt, f"{DRY_RUN_MARK}(演示·未测量·无行更新)")
        print(f"  ── 台账（§3.2 唯一落盘）───────────────────────────────")
        print(f"  {os.path.relpath(DEST_RUNSLOG, ROOT)} += {line.rstrip()}")
        print(f"  主表：未写（干跑演示行只走 stdout）· runs/{run_id}/：未建（干跑无原始产物）")
        return 0

    # ── 真跑：命令须携全行键（§3.3.1 四元组·ISSUE-091 由命令签名兜住）────────────────
    if not op or not engine or not regime:
        ap.error("真跑须给全行键：bench <op> <format> --board <板> --engine <e> --regime <r>\n"
                 f"  缺：{'op ' if not op else ''}{'--engine ' if not engine else ''}"
                 f"{'--regime' if not regime else ''}（§3.3.1 行键 = (op,format,engine,regime)）")
    if not any(r["op"] == op for r in rows):
        ap.error(f"(op={op}, format={fmt}) 不在 roster。该 format 的 op：{' '.join(r['op'] for r in rows)}")
    print(f"  行键    = ({op}, {fmt}, {engine}, {regime})")
    print()

    if cfg["block"]:
        result = f"{VOID_DIRTY_BOARD}(板不开测：{cfg['block']})"
        append_runs_log(run_id, fmt, result)
        print(f"  拒测：{cfg['block']}")
        return 1

    run_dir = os.path.join(DEST_RUNS, run_id)

    # 五步按序，任一 VOID 即止 —— 不计时、不入行、只落台账一行（§3.3 / §3.2.2）。
    # run_dir 延迟到 step3（第一个写原档的步）才建：step1/step2 的早 VOID 不留空目录。
    _, void = step1_preflight(board, cfg, True)
    if void:
        append_runs_log(run_id, fmt, void)
        print(f"  {void} —— 不测")
        return 1
    _, lineage = step2_lineage(board, cfg, True)
    if not lineage:
        append_runs_log(run_id, fmt, f"{VOID_DIRTY_BOARD}(世系探针无读数)")
        return 1
    print(f"  世系    = {lineage}")

    os.makedirs(run_dir, exist_ok=True)
    _, r3 = step3_crosscheck(fmt, board, cfg, True, op=op, run_dir=run_dir)
    if isinstance(r3, str):     # VOID
        append_runs_log(run_id, fmt, r3)
        print(f"  {r3} —— 不计时")
        return 1
    print(f"  对拍    = 三验 PASS · 部署对手 {r3['opp_sym']} · 档={r3['opp_caliber']} · 我方向量指令(ex-vset)={r3['our_vector_ex_vset']}")

    _, r4 = step4_cold(fmt, board, cfg, True, op=op, run_dir=run_dir)
    if isinstance(r4, str):     # VOID
        append_runs_log(run_id, fmt, r4)
        print(f"  {r4} —— 不入行")
        return 1
    seeds = " ".join(f"{s['seed']}={s['ratio_cold_X']:.4f}" for s in r4["seeds"])
    print(f"  cold    = ratio_cold_X {seeds}（近门={r4['near_gate']}·{r4['noise'] or '标称'}）")

    row = assemble_row(op, fmt, engine, regime, r3, r4, lineage, run_id)
    _, s5 = step5_row(run_id, True, row=row, board=board, run_dir=run_dir)
    mstatus, mold, mnew, mline = s5["master"]

    result = f"{row['判定']}·cold_X={row['cold']}·master-{mstatus}"
    line = append_runs_log(run_id, fmt, result)
    print()
    header, values = render_row(row)
    print(f"  ── 行（§3.3.1 {len(ROW_SCHEMA)} 字段）─────────────────────────────")
    print(f"  {header}")
    print(f"  {values}")
    print(f"  ── 三目的地 ─────────────────────────────────────────────")
    print(f"  runs.log         += {line.rstrip()}")
    print(f"  runs/{run_id}/  ← verify.stdout.txt · measure.stdout.txt · row.csv")
    if mstatus == "no-row":
        print(f"  主表 {os.path.relpath(MASTER_TABLE, ROOT)}：★无命中行 (op={op},format={fmt},engine={engine}) —— 未更新（见报告）")
    else:
        print(f"  主表 {os.path.relpath(MASTER_TABLE, ROOT)} 行{mline} {board}_cold：{mold} → {mnew}（{mstatus}）")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (SchemaDrift, CellRecipeMissing) as exc:
        print(f"[bench] {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(2)
