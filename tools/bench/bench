def guarded_open(path, mode):
    """§3.2.2 测量禁止创建三处目的地以外的任何文件。写路径不在闸内 = 中止，不是警告。

    bench 的两个可写目的地：runs/<run-id>/ 与 runs.log。experiments/master/
    由 recon 独占发布；把它加入本写闸会重新制造 ISSUE-098 双 writer。
    """
    real = os.path.realpath(path)
    allowed = (
        real == os.path.realpath(DEST_RUNSLOG)
        or real.startswith(os.path.realpath(DEST_RUNS) + os.sep)
    )
    if not allowed:
        raise SystemExit(
            f"[destination-guard] 拒绝写入 {real}\n"
            f"  bench 只许：{DEST_RUNS}/<run-id>/ · {DEST_RUNSLOG}\n"
            f"  canonical master {DEST_MASTER}/ 由 recon 独占发布；"
            f"旧址 {MASTER_INTERIM} 同样拒绝。"
        )
    return open(real, mode, encoding="utf-8")


