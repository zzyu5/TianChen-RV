def resolve_cell_route(op, fmt, board, engine):
    """精确解析一个已实现 cell；无 wildcard、同名猜测或旧路径 fallback。"""
    matches = [
        route for route in CELL_ROUTES
        if route["op"] == op
        and board in route["boards"]
        and engine in route["engines"]
        and fmt in route["formats"]
    ]
    if len(matches) != 1:
        raise CellRecipeMissing(
            "ROUTE_COMBINATION_UNSUPPORTED: canonical cell route 必须精确命中一次："
            f"(op={op}, format={fmt}, board={board}, engine={engine})；命中 {len(matches)}。"
        )
    path = os.path.join(CELLS_DIR, matches[0]["harness"])
    if not os.path.isfile(path):
        raise CellRecipeMissing(
            f"ROUTE_TARGET_MISSING: registry 指向不存在的 harness {os.path.relpath(path, ROOT)}"
        )
    return path


def _run_harness(harness, board, mode, fmt, timeout):
    """本地调 harness（harness 内部 ssh 板）；捕获 stdout+stderr。返回 (rc, text)；超时 rc=None。"""
    try:
        out = subprocess.run(
            ["bash", harness, board, mode, fmt],
            capture_output=True, text=True, timeout=timeout,
        )
    except subprocess.TimeoutExpired as exc:
        return None, (exc.stdout or "") + (exc.stderr or "")
    return out.returncode, (out.stdout or "") + (out.stderr or "")


_SECTION_RE = re.compile(r"^=== \[(A|Boff|B|C|D|E|F)\]")


def _split_sections(text):
    sections, cur = {"pre": []}, "pre"
    for ln in text.splitlines():
        m = _SECTION_RE.match(ln)
        if m:
            cur = m.group(1)
            sections[cur] = []
        sections.setdefault(cur, []).append(ln)
    return sections


def _mism(lines, needle):
    for ln in lines:
        if needle in ln:
            m = re.search(r"mism=(\d+)/(\d+)", ln)
            if m:
                return int(m.group(1))
    return None


def _parse_ours_leaf(text):
    m = re.search(r"# OURS_leaf \[ins=(\d+) rvv=(\d+) gather=(\d+) vset=(\d+)\]", text)
    if not m:
        return None
    ins, rvv, gat, vs = map(int, m.groups())
    return {"ins": ins, "rvv": rvv, "gather": gat, "vset": vs, "vector_ex_vset": rvv - vs}


def _parse_opp(text):
    entries = {}
    for ln in text.splitlines():
        m = re.match(
            r"# OPP (\S+) (PRESENT|ABSENT) @(\S*) m1\[ins=(\d+) rvv=(\d+) gather=(\d+) vset=(\d+)\]",
            ln,
        )
        if m:
            entries[m.group(1)] = {
                "present": m.group(2) == "PRESENT",
                "addr": m.group(3),
                "ins": int(m.group(4)),
                "rvv": int(m.group(5)),
                "gather": int(m.group(6)),
                "vset": int(m.group(7)),
            }
    return entries


def _cpu_md5_stable(text):
    """静板续证：libggml-cpu.so 运行前后 md5 一致（对手库未在测量中变身）。"""
    before = re.search(r"# cpu_md5_before=([0-9a-f]+)", text)
    after = re.search(r"# cpu_md5_after=([0-9a-f]+)", text)
    if not before or not after:
        return None
    return before.group(1) == after.group(1)


def _opp_caliber(deployed):
    """§3.4 对手档：部署 _vlNNN 有向量运算 = 手调；纯标量 = 标量类。"""
    if deployed is None or not deployed.get("present"):
        return "未部署"
    return "手调" if deployed["rvv"] > 0 else "标量类"


def _parse_gemm_verify(text, fmt, board, engine):
    """唯一 GEMM verify parser；旧 step3 内联语法已退役。"""
    if engine != "rvv":
        return f"{VOID_OURS_WRONG}(GEMM parser 不接受 engine={engine})"
    sec = _split_sections(text)
    clean = sec.get("A", []) + sec.get("E", [])
    ours = _mism(clean, "T2 ours")
    oppg = _mism(clean, "T2 OPP-G")
    oppx = _mism(clean, "T2 OPP-X")
    t1 = _mism(sec.get("A", []), "T1 BOARD-BYTE-EXACT")
    if "-> PASS" not in "\n".join(ln for ln in clean if "ABI-GATE" in ln):
        return f"{VOID_OURS_WRONG}(ABI-GATE 非 PASS)"
    if ours is None or oppx is None or oppg is None or t1 is None:
        return f"{VOID_OURS_WRONG}(GEMM 对拍三验解析不出 mism)"
    if t1 != 0 or ours != 0:
        return f"{VOID_OURS_WRONG}(我方 vs oracle mism T1={t1} T2={ours})"
    if oppx != 0:
        return f"{VOID_OPP_BAD}(部署对手 OPP-X vs oracle mism={oppx})"
    if oppg != 0:
        return f"{VOID_OPP_BAD}(参照对手 OPP-G vs oracle mism={oppg})"

    def gate(letter, who):
        for ln in sec.get(letter, []):
            if "GATE-" in ln and "=" in ln:
                match = re.search(who + r"\s*=\s*(PASS|FAIL)", ln)
                if match:
                    return match.group(1)
        return None

    if gate("B", "GATE-OURS") != "FAIL":
        return f"{VOID_OURS_WRONG}(anti-hollow[B] oracle-fault 未被 gate 咬)"
    if gate("C", "GATE-OURS") != "FAIL" or gate("C", "GATE-OPPX") != "PASS":
        return f"{VOID_OURS_WRONG}(anti-hollow[C] DUT-fault gate 空心)"
    if gate("D", "GATE-OURS") != "FAIL" or gate("D", "GATE-OPPX") != "PASS":
        return f"{VOID_OURS_WRONG}(anti-hollow[D] leaf-byte-fault gate 空心)"

    opp = _parse_opp(text)
    thunk = f"ggml_vec_dot_{fmt}_q8_K"
    vltag = "vl128" if board == "rvv" else "vl256"
    vlsym = f"{thunk}_{vltag}"
    if not opp.get(thunk, {}).get("present"):
        return f"{VOID_DISPATCH_MISMATCH}(派发 thunk {thunk} ABSENT)"
    deployed = opp.get(vlsym)
    if deployed is None or not deployed.get("present"):
        return f"{VOID_DISPATCH_MISMATCH}(部署核 {vlsym} ABSENT)"

    ours_leaf = _parse_ours_leaf(text)
    return {
        "opp_sym": f"{thunk}(→{vltag}·CROSSOP)",
        "opp_caliber": _opp_caliber(deployed),
        "opp_evidence": (
            f"objdump dispatch: {vlsym}@{deployed['addr']} "
            f"rvv{deployed['rvv']}/vset{deployed['vset']}/gather{deployed['gather']}"
        ),
        "our_vector_ex_vset": (ours_leaf or {}).get("vector_ex_vset"),
        "our_leaf": ours_leaf,
    }


def _vec_all(text, expected):
    matches = re.findall(
        r"# BYTE_EXACT ours_vs_ggml_deployed=(true|false) "
        r"ours_vs_int_oracle=(true|false) ggml_vs_int_oracle=(true|false) "
        r"ALL=(true|false)",
        text,
    )
    if len(matches) != 1:
        return False
    values = matches[0]
    if expected == "true":
        return all(value == "true" for value in values)
    return values[3] == "false" and any(value == "false" for value in values[:3])


def _parse_vec_dot_verify(text, fmt, board, engine):
    """K-quant 与 dormant scalar vec_dot 的 typed verify parser。"""
    sec = _split_sections(text)
    if board == "scalar":
        if engine != "scalar" or fmt != "tq2_0":
            return f"{VOID_OURS_WRONG}(scalar vec_dot parser identity mismatch)"
        zero = re.search(
            r"# ZEROVEC kernel\.o \[scalar_ins=\d+ vector_mnemonic=(\d+) vset=(\d+) "
            r"cpop_clmul=\d+\] riscv_intrinsic=(\d+) weft_rvv_sym=(\d+)",
            text,
        )
        libzero = re.search(r"# ZEROVEC deployed_ggml_lib v_mnemonic_lines=(\d+)", text)
        if not zero or any(int(value) != 0 for value in zero.groups()):
            return f"{VOID_OURS_WRONG}(scalar owned kernel 不是 zero-vector)"
        if not libzero or int(libzero.group(1)) != 0:
            return f"{VOID_DISPATCH_MISMATCH}(scalar deployed ggml 不是 no-V build)"
        if not _vec_all("\n".join(sec.get("A", [])), "true"):
            return f"{VOID_OURS_WRONG}(scalar symmetric byte-exact 非 ALL=true)"
        if not _vec_all("\n".join(sec.get("Boff", [])), "true"):
            return f"{VOID_OURS_WRONG}(scalar neutral byte-exact 非 ALL=true)"
        for letter, inject in (("C", 1), ("D", 2)):
            arm = "\n".join(sec.get(letter, []))
            if not re.search(rf"# ANTIHOLLOW inject={inject} .* -> BITES-OK", arm):
                return f"{VOID_OURS_WRONG}(scalar anti-hollow[{letter}] 未咬)"
        return {
            "opp_sym": "ggml_vec_dot_tq2_0_q8_K(→generic·no-V)",
            "opp_caliber": "标量类",
            "opp_evidence": "ZEROVEC owned/deployed=0；dormant parser fact，非 run eligibility",
            "our_vector_ex_vset": 0,
            "our_leaf": {"vector_ex_vset": 0},
        }

    if engine != "rvv" or fmt not in _K_VECDOT_FORMATS:
        return f"{VOID_OURS_WRONG}(K-quant vec_dot parser identity mismatch)"
    clean = "\n".join(sec.get("A", []))
    identity = re.search(
        rf"# VECDOT_CORRECT fmt={re.escape(fmt)} op=vec_dot engine=rvv "
        r"regime=micro-fixed inject=0 min_active=0 .* vlen=(\d+)",
        clean,
    )
    expected_vlen = 128 if board == "rvv" else 256
    if not identity or int(identity.group(1)) != expected_vlen:
        got = identity.group(1) if identity else "missing"
        return f"{VOID_DISPATCH_MISMATCH}(runtime VLEN={got}，expected {expected_vlen})"
    required_clean = (
        re.search(r"# INPUT_CONTRACT q8_K_bsums_match_qs=true inject=0 -> PASS", clean),
        re.search(r"# fp16_primitive_golden=PASS", clean),
        re.search(rf"# CORPUS fmt={re.escape(fmt)} .* -> COMPLETE", clean),
        re.search(r"# OWNED_FIVE_SYMBOLS count=5 expected=5", text),
    )
    if not all(required_clean) or not _vec_all(clean, "true"):
        return f"{VOID_OURS_WRONG}(vec_dot clean contract/corpus/五叶闭包/byte-exact 不完整)"
    for letter, inject in (("B", 1), ("C", 2)):
        arm = "\n".join(sec.get(letter, []))
        if not re.search(rf"# ANTIHOLLOW inject={inject} .* -> BITES-OK", arm):
            return f"{VOID_OURS_WRONG}(vec_dot anti-hollow[{letter}] 未咬)"
    if _vec_all("\n".join(sec.get("D", [])), "false") is not True:
        return f"{VOID_OURS_WRONG}(vec_dot leaf-byte fault[D] 未咬)"
    bsum_fault = "\n".join(sec.get("F", []))
    if not re.search(
        r"# INPUT_CONTRACT q8_K_bsums_match_qs=false inject=3 -> BITES-OK",
        bsum_fault,
    ):
        return f"{VOID_OURS_WRONG}(q8 bsums 输入契约负控[F] 未咬)"

    min_formats = {"q2_K", "q4_K", "q5_K"}
    if fmt in min_formats:
        active = "\n".join(sec.get("E", []))
        witness = re.search(
            rf"# MIN_TERM_COUNTERFACTUAL fmt={re.escape(fmt)} "
            r"active_vs_dmin0_ours=(\d+)/(\d+) oracle=(\d+)/(\d+) "
            r"dmin0_ours_vs_oracle_mism=(\d+) min_term_nonzero=true -> BITES-OK",
            active,
        )
        if (
            not witness
            or int(witness.group(1)) == 0
            or int(witness.group(3)) == 0
            or int(witness.group(5)) != 0
            or not re.search(r"min_active=1", active)
            or not _vec_all(active, "true")
            or not re.search(r"min_term_nonzero=true -> COMPLETE", active)
        ):
            return f"{VOID_OURS_WRONG}(min-term-active[E] witness/反事实/byte-exact 不完整)"
    elif "E" in sec:
        return f"{VOID_OURS_WRONG}(无 min-term 格式意外出现 active arm)"

    ours = re.search(
        r"# OURS_leaf \[scalar_ins=(\d+) vector_mnemonic=(\d+) vset=(\d+) "
        r"gather=(\d+) vfp=(\d+)\] non_vset_vector=(\d+)",
        text,
    )
    opp = re.search(
        rf"# OPP (ggml_vec_dot_{re.escape(fmt)}_q8_K) PRESENT "
        r"runtime_path=(\S+) path_kind=(vl128|vl256|generic|exported) "
        r"dispatch_proof=(\S+) \[ins=(\d+) non_vset_vector=(\d+)\] "
        r"caliber=(手调|通用向量|标量类) family=\[(.*)\]",
        text,
    )
    vltag = "vl128" if board == "rvv" else "vl256"
    if not ours:
        return f"{VOID_OURS_WRONG}(OURS leaf 指令证据解析失败)"
    if not opp:
        return f"{VOID_DISPATCH_MISMATCH}(部署对手 runtime path 解析失败)"
    path, path_kind = opp.group(2), opp.group(3)
    path_valid = (
        (path_kind == vltag and path.startswith(f"{opp.group(1)}_{vltag}"))
        or (path_kind == "generic" and path.startswith(f"{opp.group(1)}_generic"))
        or (path_kind == "exported" and path.startswith(opp.group(1)))
    )
    if not path_valid:
        return f"{VOID_DISPATCH_MISMATCH}(部署对手 path/kind 不自洽: {path_kind}→{path})"
    non_vset = int(ours.group(6))
    return {
        "opp_sym": f"{opp.group(1)}(→{path})",
        "opp_caliber": opp.group(7),
        "opp_evidence": (
            f"objdump deployment: kind={path_kind} path={path} proof={opp.group(4)} "
            f"non-vset-vector={opp.group(6)}; runtime-vlen={expected_vlen}; "
            "fixed-fixture byte-exact"
        ),
        "our_vector_ex_vset": non_vset,
        "our_leaf": {
            "ins": int(ours.group(1)), "rvv": int(ours.group(2)),
            "vset": int(ours.group(3)), "gather": int(ours.group(4)),
            "vfp": int(ours.group(5)), "vector_ex_vset": non_vset,
        },
    }


def _parse_product_reduce_verify(text, fmt, board, engine):
    """product_reduce 三格式共享输出 contract；格式分发仍只属于 cell/driver。"""
    if engine != "rvv" or fmt not in _PRODUCT_REDUCE_FORMATS:
        return f"{VOID_OURS_WRONG}(product_reduce parser identity mismatch)"
    sec = _split_sections(text)
    clean = "\n".join(sec.get("A", []))
    clean_matches = re.findall(
        rf"VERIFY op={re.escape(fmt)} .* inject=0 : int_mismatch=0 .* "
        r"=> BYTE-EXACT-vs-scalar-ref OK",
        clean,
    )
    if len(clean_matches) != 1:
        return f"{VOID_OURS_WRONG}(product_reduce clean byte-exact contract 不完整)"
    for letter, inject in (("B", 1), ("C", 2)):
        arm = "\n".join(sec.get(letter, []))
        arm_matches = re.findall(
            rf"VERIFY op={re.escape(fmt)} .* inject={inject} : int_mismatch=[1-9]\d* .* "
            r"=> ANTI-HOLLOW BITES-OK",
            arm,
        )
        if len(arm_matches) != 1:
            return f"{VOID_OURS_WRONG}(product_reduce anti-hollow[{letter}] 未咬)"
    ours = re.search(
        rf"# OURS_{re.escape(fmt)} .* non_vset_vector=(\d+)",
        text,
    )
    refs = set(re.findall(
        r"# OPP-IDENTITY product_reduce ref=scalar-ref\(([^)]+)\) caliber=标量类",
        text,
    ))
    expected_refs = {"sc_nibble", "sc_offbin", "sc_codebook"}
    if not ours:
        return f"{VOID_OURS_WRONG}(product_reduce owned 指令证据解析失败)"
    if refs != expected_refs:
        return f"{VOID_DISPATCH_MISMATCH}(product_reduce scalar-ref identity 不完整: {sorted(refs)})"
    selected_ref = {
        "q4_0_nibble": "sc_nibble",
        "offset_binary_n3": "sc_offbin",
        "codebook_n3": "sc_codebook",
    }[fmt]
    return {
        "opp_sym": f"scalar-ref({selected_ref})",
        "opp_caliber": "标量类",
        "opp_evidence": "constructed same-arithmetic scalar-ref; ggml standalone absent",
        "our_vector_ex_vset": int(ours.group(1)),
        "our_leaf": {"vector_ex_vset": int(ours.group(1))},
    }


