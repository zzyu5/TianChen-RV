        "我方链": f"{cfg['cc']} -march={cfg['march']} {cfg['cflags']} {cfg['ldextra']}".strip(),
        "对手链": f"同链同板（对手 = {cfg['ggml']} 的板端 clang-18 构建）",
        "世系三元": "{板 = uname -m/-r + /proc/cpuinfo isa · 链 = $CC --version 实读 · 批次 = ggml pin + so 的 md5}",
        "gcc": "§3.6：gcc 不存在 —— --gcc-install-dir 是 clang 的 CRT 定位器，非 gcc 构建",
    }
    if not execute:
