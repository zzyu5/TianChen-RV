_SPEC_FIELD_RE = re.compile(r"^\|\s*\*\*(?P<field>[^*|]+)\*\*\s*\|.*\|\s*(?P<step>[^|]*?)\s*\|\s*$")


def spec_row_schema(path=SPEC_PIPELINE):
    """从 spec §3.3.1 的字段表机核抽出权威字段序列。禁手抄、禁默认值。"""
    with open(path, encoding="utf-8") as fh:
        lines = fh.read().splitlines()
    start = end = None
    for i, ln in enumerate(lines):
        if start is None and ln.startswith("### 3.3.1"):
            start = i
        elif start is not None and ln.startswith("## ") and i > start:
            end = i
            break
    if start is None:
        raise SchemaDrift(f"spec §3.3.1 章节在 {path} 中未找到")
    fields = []
    for ln in lines[start : (end if end is not None else len(lines))]:
        m = _SPEC_FIELD_RE.match(ln)
        if m:
            fields.append(m.group("field").strip())
    if not fields:
        raise SchemaDrift(f"spec §3.3.1 字段表解析出 0 字段（{path}）")
    return tuple(fields)


