    """对拍（一步三验）：我方 vs oracle · 对手 vs oracle · 对手就是真实派发的那一个。

    execute：调 cells/ harness verify → 解析 ABI-GATE / T2 三验 / 4-arm anti-hollow /
    我方向量指令数 / 部署派发身份 + 档。任一失败落对应 VOID（不计时）。
    """
    plan = {
        "步": "3 · 对拍（硬点：一步三验）",
        "验 ①": f"我方 vs oracle（[K-5] 整数 byte-exact / 浮点 ULP 上界）→ 失败 = {VOID_OURS_WRONG}",
        "验 ②": f"对手 vs oracle（同一 oracle）→ 失败 = {VOID_OPP_BAD}（禁用坏对手时间算倍率）",
        "验 ③": f"对手 = 该板 ggml 实际部署派发的函数（objdump dispatch/类型注册表）→ 不符 = {VOID_DISPATCH_MISMATCH}",
        "向量指令数": "objdump -d 我方 .o，TAB-field-aware awk 计 $3~/^v/ 且剔除 ^vset（配置指令）与死值；记录不拦截",
        "对手档": "{手调 | 通用向量 | 标量类} 逐格证据判定（§3.4），证据引用入行",
        "任一失败": "不计时",
    }
    if not execute:
        return plan, None

    harness = cell_harness(op)
    rc, text = _run_harness(harness, board, "verify", fmt, HARNESS_TIMEOUT_VERIFY)
    if run_dir is not None:
        with guarded_open(os.path.join(run_dir, "verify.stdout.txt"), "w") as fh:
            fh.write(text)
    if rc is None:
        return plan, f"{VOID_OURS_WRONG}(verify harness 超时)"
    if rc != 0:
        # 板端硬失败（build/probe VOID）——归我方错，除非 stdout 明说对手废/派发不符。
        return plan, f"{VOID_OURS_WRONG}(verify harness rc={rc})"
    if "# ALL_DONE" not in text:
        return plan, f"{VOID_OURS_WRONG}(verify 未跑完·无 ALL_DONE)"
    if _cpu_md5_stable(text) is False:
        return plan, f"{VOID_DIRTY_BOARD}(对手库 md5 测量中变身)"

    sec = _split_sections(text)
    # 干净段 [A]（T1 exact shape）+ [E]（T2 measure shape）—— 三验须全过。
    clean = sec.get("A", []) + sec.get("E", [])
    ours = _mism(clean, "T2 ours")
    oppg = _mism(clean, "T2 OPP-G")
    oppx = _mism(clean, "T2 OPP-X")
    t1 = _mism(sec.get("A", []), "T1 BOARD-BYTE-EXACT")
    if "-> PASS" not in "\n".join(l for l in clean if "ABI-GATE" in l):
        return plan, f"{VOID_OURS_WRONG}(ABI-GATE 非 PASS)"
    if ours is None or oppx is None or oppg is None or t1 is None:
        return plan, f"{VOID_OURS_WRONG}(对拍三验解析不出 mism)"
    if t1 != 0 or ours != 0:
        return plan, f"{VOID_OURS_WRONG}(我方 vs oracle mism T1={t1} T2={ours})"
    if oppx != 0:
        return plan, f"{VOID_OPP_BAD}(部署对手 OPP-X vs oracle mism={oppx})"
    if oppg != 0:
        return plan, f"{VOID_OPP_BAD}(参照对手 OPP-G vs oracle mism={oppg})"

    # 4-arm anti-hollow：[B] 全 RED（三 GATE FAIL）· [C]/[D] 仅 OURS RED（gate 咬到发射的 RISC-V）。
    def _gate(letter, who):
        for ln in sec.get(letter, []):
            if "GATE-" in ln and "=" in ln:
                m = re.search(who + r"\s*=\s*(PASS|FAIL)", ln)
                if m:
                    return m.group(1)
        return None
    if _gate("B", "GATE-OURS") != "FAIL":
        return plan, f"{VOID_OURS_WRONG}(anti-hollow[B] oracle-fault 未被 gate 咬)"
    if _gate("C", "GATE-OURS") != "FAIL" or _gate("C", "GATE-OPPX") != "PASS":
        return plan, f"{VOID_OURS_WRONG}(anti-hollow[C] DUT-fault gate 空心)"
    if _gate("D", "GATE-OURS") != "FAIL" or _gate("D", "GATE-OPPX") != "PASS":
        return plan, f"{VOID_OURS_WRONG}(anti-hollow[D] leaf-byte-fault gate 空心)"

    # 验③：部署派发 —— dispatch thunk PRESENT + 该板 _vlNNN PRESENT。
    opp = _parse_opp(text)
    thunk = f"ggml_vec_dot_{fmt}_q8_K"
    vltag = "vl128" if board == "rvv" else "vl256"
    vlsym = f"{thunk}_{vltag}"
    if not opp.get(thunk, {}).get("present"):
        return plan, f"{VOID_DISPATCH_MISMATCH}(派发 thunk {thunk} ABSENT)"
    deployed = opp.get(vlsym)
    if deployed is None or not deployed.get("present"):
        return plan, f"{VOID_DISPATCH_MISMATCH}(部署核 {vlsym} ABSENT)"

    ours_leaf = _parse_ours_leaf(text)
    result = {
        "opp_sym": f"{thunk}(→{vltag}·CROSSOP)",
        "opp_caliber": _opp_caliber(deployed),
        "opp_evidence": (
            f"objdump dispatch: {vlsym}@{deployed['addr']} "
            f"rvv{deployed['rvv']}/vset{deployed['vset']}/gather{deployed['gather']}"
        ),
        "our_vector_ex_vset": (ours_leaf or {}).get("vector_ex_vset"),
        "our_leaf": ours_leaf,
    }
    return plan, result


_GEMM_PREFILL_RE = re.compile(
    r"GEMM_PREFILL fmt=(\S+) .* seed=0x([0-9A-Fa-f]+) \| "
    r"ours_med_ns=(\d+)\(iqr[\d.]+%\) oppG_med_ns=(\d+)\(iqr[\d.]+%\) "
    r"oppX_med_ns=(\d+)\(iqr[\d.]+%\) \| ratio_cold_G=([\d.]+) ratio_cold_X=([\d.]+)"
)


def step4_cold(fmt, board, cfg, execute, op=None, run_dir=None):
    """cold 计时：预注册重复数，冷启动唯一。ratio_cold_X = 我方 vs 部署对手（头条）。"""
    plan = {
        "步": "4 · cold 计时",
        "预注册": "重复数 N 先于测量预注册（§3.6 预注册先于测量）",
        "冷启动唯一": f"每 rep 前 flush {cfg['flush_mb']} MiB（> 该板 LLC）· taskset -c <best-core>",
        "禁继承": "§3.6：decode 一律 M=1 实测；IME 禁承 native",
        "近门": f"仅当比值 ∈ [{NEAR_GATE_LO}, {NEAR_GATE_HI}] 追加一次独立复测确认 → 打噪声标",
    }
    if not execute:
        return plan, None

    harness = cell_harness(op)
    rc, text = _run_harness(harness, board, "measure", fmt, HARNESS_TIMEOUT_MEASURE)
    if run_dir is not None:
        with guarded_open(os.path.join(run_dir, "measure.stdout.txt"), "w") as fh:
            fh.write(text)
    if rc is None:
        return plan, f"{VOID_DIRTY_BOARD}(measure harness 超时)"
    if "# VOID-LOAD" in text:
        return plan, f"{VOID_DIRTY_BOARD}(measure 载荷门未过)"
    if rc != 0 or "# ALL_DONE" not in text:
        return plan, f"{VOID_DIRTY_BOARD}(measure harness rc={rc} 未跑完)"
    if _cpu_md5_stable(text) is False:
        return plan, f"{VOID_DIRTY_BOARD}(对手库 md5 测量中变身)"

    seeds = []
    for m in _GEMM_PREFILL_RE.finditer(text):
        seeds.append({
            "seed": "0x" + m.group(2),
            "ours_med_ns": int(m.group(3)),
            "oppX_med_ns": int(m.group(5)),
            "ratio_cold_G": float(m.group(6)),
            "ratio_cold_X": float(m.group(7)),
        })
    if not seeds:
        return plan, f"{VOID_DIRTY_BOARD}(measure 解析不出 GEMM_PREFILL 行)"

    cold_x = seeds[0]["ratio_cold_X"]         # 主表落 s1（与 P2 seal 口径一致）
    near = is_near_gate(cold_x)
    noise = ""
    if near and len(seeds) >= 2:
        spread = abs(seeds[0]["ratio_cold_X"] - seeds[1]["ratio_cold_X"])
        noise = f"近门·2seed一致(Δ={spread:.4f})" if spread < 0.05 else f"近门·2seed分散(Δ={spread:.4f})"
    result = {
        "cold": f"{cold_x:.4f}",
        "cold_x_s1": cold_x,
        "seeds": seeds,
        "near_gate": near,
        "noise": noise,
    }
    return plan, result


def classify_verdict(cold):
    """Return the canonical raw master disposition; noise is separate.

    `WIN/LOSS/near-parity` was an event-local alias set outside the normative
    §3.3.1.1 value domain.  The 0.8 cell gate is represented as PASS/具名-X;
    beat/tie/opponent caliber remains an independent evidence judgment.
    """
    return "PASS" if cold >= HARD_GATE_0P8 else "具名-X"


def assemble_row(op, fmt, engine, regime, r3, r4, lineage, run_id):
    """按 §3.3.1 narrow schema 组行。数字全来自 harness stdout 解析，零手算。"""
    cold_x = r4["cold_x_s1"]
    return {
        "op": op,
        "format": fmt,
        "engine": engine,
        "regime": regime,
        "cold": r4["cold"],
        "判定": classify_verdict(cold_x),
        "对手符号": r3["opp_sym"],
        "对手档": r3["opp_caliber"],
        "对手证据引用": r3["opp_evidence"],
        "我方向量指令数": str(r3["our_vector_ex_vset"]),
        "世系": lineage,
        "run-id": run_id,
        "噪声标": r4["noise"] or "标称",
    }


def step5_row(run_id, execute, row=None, run_dir=None):
    """封存 run event；canonical master 只能由 recon 从合格证据重建。

    这里刻意没有 master writer、compatibility flag 或 best-effort mirror。尚未经过
    correctness/T-N/freshness qualification 的 run 只是 measured evidence，不能由
    bench 自行升格成 canonical result。
    """
    plan = {
        "步": "5 · 封存候选行",
        "字段": " / ".join(ROW_SCHEMA),
        "目的地": "runs/<run-id>/row.csv；runs.log 由调用者追加",
        "canonical master": "recon-only；qualification 前保持字节不变",
        "VOID": "VOID 不产 row.csv，只在 runs.log 留一行",
    }
    if not execute:
        return plan, None

    header, values = render_row(row)
    with guarded_open(os.path.join(run_dir, "row.csv"), "w") as fh:
        fh.write(header + "\n" + values + "\n")
    return plan, {"capture": "measured-unqualified", "row": row}


def render_row(row):
    header = ",".join(ROW_SCHEMA)
    values = ",".join(row[f] for f in ROW_SCHEMA)
    return header, values


# ───────────────────────────────────────────────────────── 自检（纯函数 · 不碰板 · 不写盘）
def self_test():
    ok = []

    assert_schema_bound()
    ok.append(f"schema 绑定：runner {len(ROW_SCHEMA)} 字段 == spec §3.3.1 字段表 {spec_row_schema()}")

    measurement_key_self_test()
    ok.append("行键负控：空值/空白/未知枚举/缺失与重复 roster 全部 fail-closed")

    # 行键四元（§3.3.1 前 4 字段）—— 三元组口径已作废，四元组才唯一定位物理行。
    assert spec_row_schema()[:4] == ROW_KEY, f"spec 行键前四字段 != {ROW_KEY}"
    ok.append(f"行键 == {ROW_KEY} 四元组（spec §3.3.1 机核 · 三元组口径作废）")

    # Dry-run 不再构造伪 row 或 DRY-RUN verdict；它只验证一个真实四元键并展示计划。
    # 因而不会制造第二套行值域，也不会向 append-only runs.log 注入非测量事件。
    ok.append("dry-run 仅做全键预检/计划展示；不构造占位 row、不分配 run-id、不写 runs.log")

    # 目的地闸真的会咬（负控）：散件、旧址和 canonical master 全拒。
    for bad in (os.path.join(ROOT, "experiments", "stray.txt"),
                os.path.join(MASTER_INTERIM, "T3_master_rebuild.csv"),
                MASTER_TABLE,
                os.path.join(ROOT, "tools", "bench", "cells", "leak.csv")):
        try:
            guarded_open(bad, "a")
        except SystemExit:
            pass
        else:
            raise AssertionError(f"目的地闸未咬：{bad}")
    ok.append("目的地闸负控：散件 · 旧址 · canonical master · tools/ 下落数据全部被拒")

    # 正控：bench 仅能写 immutable run 与 append-only log。
    for good in (DEST_RUNSLOG, os.path.join(DEST_RUNS, "RID", "x.log")):
        real = os.path.realpath(good)
        allowed = (
            real == os.path.realpath(DEST_RUNSLOG)
            or real.startswith(os.path.realpath(DEST_RUNS) + os.sep)
        )
        assert allowed, f"目的地闸误咬合法路径：{good}"
    ok.append("目的地闸正控：仅 runs.log · runs/<run-id>/ 放行；master 由 recon 独占")

    assert is_near_gate(0.85) and is_near_gate(0.7) and is_near_gate(1.0)
    assert not is_near_gate(0.69) and not is_near_gate(1.01)
    ok.append(f"近门区间 [{NEAR_GATE_LO}, {NEAR_GATE_HI}] 闭区间判定（含端点）")

    assert classify_verdict(0.8) == "PASS" and classify_verdict(0.7999) == "具名-X"
    assert classify_verdict(1.1) == "PASS"
    ok.append("判定值域：0.8 hard gate → PASS/具名-X；无事件局部 alias")

    assert len(VOID_REASONS) == 4, "VOID 出口数与 §3.3 不符"
    ok.append(f"VOID 四出口：{' / '.join(VOID_REASONS)}")

    rid = make_run_id("q4_0", "rvv")
    assert re.match(r"^\d{8}T\d{6}Z-q4_0-rvv-[0-9a-f]{8}$", rid), rid
    ok.append("run-id 形态 <UTC>-<格>-<板>-<8hex>（板经 run-id 编码 ⟹ 台账不增字段）")

    assert set(BOARDS) == {"rvv", "k1", "scalar", "rvv07"}, "板册与 §3.1 四板不符"
    assert not BOARDS["scalar"]["measurable"] and not BOARDS["rvv07"]["measurable"]
    ok.append("板册 == §3.1 四板；scalar（ISSUE-061）与 rvv07（ISSUE-063）真实模式不开测")

    for line in ok:
        print(f"  PASS  {line}")
    print(f"\n[self-test] {len(ok)}/{len(ok)} PASS")
    return 0


# ───────────────────────────────────────────────────────── main
def main(argv=None):
    ap = argparse.ArgumentParser(
        prog="bench",
        description="唯一合法测量动作（.trellis/spec/measurement §3.3）。本层是权威，本 runner 是实现。",
    )
    # 行键四元组（§3.3.1）：真跑与 dry-run 共用同一完整签名；没有旧式单参数入口。
    ap.add_argument("op", nargs="?", help="算子 op，如 gemm_tile")
    ap.add_argument("format", nargs="?", help="量化格式 format，如 iq3_xxs")
    ap.add_argument("--board", help="板：" + " | ".join(BOARDS))
    ap.add_argument("--engine", help="引擎 engine：" + " | ".join(sorted(ENGINE_VALUES))
                    + "（真跑与 dry-run 均必填）")
    ap.add_argument("--regime", help="相 regime：" + " | ".join(sorted(REGIME_VALUES))
                    + "（真跑与 dry-run 均必填）")
    ap.add_argument("--dry-run", action="store_true",
                    help="无副作用全键预检：零 ssh · 零计时 · 零文件写")
    ap.add_argument("--self-test", action="store_true", help="纯函数自检（不碰板、不写盘）")
    args = ap.parse_args(argv)

    if args.self_test:
        return self_test()

    op, fmt = args.op, args.format
    board, engine, regime = args.board, args.engine, args.regime
    execute = not args.dry_run

    if not op or not fmt or not board or not engine or not regime:
        ap.error("用法（真跑）：bench <op> <format> --board <板> --engine <e> --regime <r>\n"
                 "         （干跑）：同一全键签名再加 --dry-run；没有单参数兼容入口")
    if board not in BOARDS:
        ap.error(f"未知板 {board}（§3.1 板册只钉死四板：{' / '.join(BOARDS)}）")

    # schema 绑定先于一切（spec 漂移 = runner 缺陷，当场红）。
    assert_schema_bound()

    cfg = BOARDS[board]
    rows = roster_rows(fmt)
    if not rows:
        ap.error(f"格 {fmt} 不在 roster（{os.path.relpath(ROSTER, ROOT)}）。已知格：{' '.join(known_formats())}")

    requested_key = (op, fmt, engine, regime)
    try:
        validate_registered_key(
            requested_key,
            roster_keys=load_roster_keys(Path(ROSTER)),
            master_keys=load_master_keys(Path(MASTER_TABLE)),
        )
    except MeasurementKeyError as exc:
        ap.error(f"measurement row-key contract failed: {exc}")

    print(f"bench {op} {fmt} --board {board}"
          + f" --engine {engine}"
          + f" --regime {regime}"
          + ("" if execute else "  --dry-run"))
    print(f"  板      = {cfg['identity']} · {cfg['vector']} · {cfg['pmu']}")
    print(f"  行键    = ({op}, {fmt}, {engine}, {regime})")

    # ── 干跑：同一正式签名、只做预检与计划展示、零文件写 ───────────────────────────
    if not execute:
        print()
        print("  ── 五步流水线（干跑：只述不做）─────────────────────────")
        for plan, _ in (
            step1_preflight(board, cfg, False),
            step2_lineage(board, cfg, False),
            step3_crosscheck(fmt, board, cfg, False),
            step4_cold(fmt, board, cfg, False),
            step5_row(None, False),
        ):
            print(f"  [{plan['步']}]")
            for k, v in plan.items():
                if k != "步":
                    print(f"      {k:<12}{v}")
        print("\n  dry-run 完成：未分配 run-id；runs.log / runs/ / master 均未写。")
        return 0

    run_id = make_run_id(fmt, board)
    print(f"  run-id  = {run_id}")
    print()

    if cfg["block"]:
        result = f"{VOID_DIRTY_BOARD}(板不开测：{cfg['block']})"
        append_runs_log(run_id, fmt, result)
        print(f"  拒测：{cfg['block']}")
        return 1

    run_dir = os.path.join(DEST_RUNS, run_id)

    # 五步按序，任一 VOID 即止 —— 不计时、不入行、只落台账一行（§3.3 / §3.2.2）。
    # run_dir 延迟到 step3（第一个写原档的步）才建：step1/step2 的早 VOID 不留空目录。
    _, void = step1_preflight(board, cfg, True)
    if void:
        append_runs_log(run_id, fmt, void)
        print(f"  {void} —— 不测")
        return 1
    _, lineage = step2_lineage(board, cfg, True)
    if not lineage:
        append_runs_log(run_id, fmt, f"{VOID_DIRTY_BOARD}(世系探针无读数)")
        return 1
    print(f"  世系    = {lineage}")

    os.makedirs(run_dir, exist_ok=True)
    _, r3 = step3_crosscheck(fmt, board, cfg, True, op=op, run_dir=run_dir)
    if isinstance(r3, str):     # VOID
        append_runs_log(run_id, fmt, r3)
        print(f"  {r3} —— 不计时")
        return 1
    print(f"  对拍    = 三验 PASS · 部署对手 {r3['opp_sym']} · 档={r3['opp_caliber']} · 我方向量指令(ex-vset)={r3['our_vector_ex_vset']}")

    _, r4 = step4_cold(fmt, board, cfg, True, op=op, run_dir=run_dir)
    if isinstance(r4, str):     # VOID
        append_runs_log(run_id, fmt, r4)
        print(f"  {r4} —— 不入行")
        return 1
    seeds = " ".join(f"{s['seed']}={s['ratio_cold_X']:.4f}" for s in r4["seeds"])
    print(f"  cold    = ratio_cold_X {seeds}（近门={r4['near_gate']}·{r4['noise'] or '标称'}）")

    row = assemble_row(op, fmt, engine, regime, r3, r4, lineage, run_id)
    _, s5 = step5_row(run_id, True, row=row, run_dir=run_dir)

    result = f"{row['判定']}·cold_X={row['cold']}·{s5['capture']}"
    line = append_runs_log(run_id, fmt, result)
    print()
    header, values = render_row(row)
    print(f"  ── 行（§3.3.1 {len(ROW_SCHEMA)} 字段）─────────────────────────────")
    print(f"  {header}")
    print(f"  {values}")
    print(f"  ── 不可变采集结果 ─────────────────────────────────────────")
    print(f"  runs.log         += {line.rstrip()}")
    print(f"  runs/{run_id}/  ← verify.stdout.txt · measure.stdout.txt · row.csv")
    print(f"  主表 {os.path.relpath(MASTER_TABLE, ROOT)}：未写（recon-only；待显式 qualification/promotion）")
    return 0


if __name__ == "__main__":
    try:
        sys.exit(main())
    except (SchemaDrift, CellRecipeMissing) as exc:
        print(f"[bench] {type(exc).__name__}: {exc}", file=sys.stderr)
        sys.exit(2)
