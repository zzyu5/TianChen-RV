def step3_crosscheck(op, fmt, board, engine, cfg, execute, harness, run_dir=None):
    """对拍（一步三验）：我方 vs oracle · 对手 vs oracle · 对手就是真实派发的那一个。

    execute：调已解析的 cells/ harness verify → 由唯一 op parser 归一化 correctness、
    反空心、我方向量指令数与对手身份。任一失败落对应 VOID（不计时）。
    """
    plan = {
        "步": "3 · 对拍（硬点：一步三验）",
        "验 ①": f"我方 vs oracle（[K-5] 整数 byte-exact / 浮点 ULP 上界）→ 失败 = {VOID_OURS_WRONG}",
        "验 ②": f"对手 vs oracle（同一 oracle）→ 失败 = {VOID_OPP_BAD}（禁用坏对手时间算倍率）",
        "验 ③": f"对手 = 该板 ggml 实际部署派发的函数（objdump dispatch/类型注册表）→ 不符 = {VOID_DISPATCH_MISMATCH}",
        "向量指令数": "objdump -d 我方 .o，TAB-field-aware awk 计 $3~/^v/ 且剔除 ^vset（配置指令）与死值；记录不拦截",
        "对手档": "{手调 | 通用向量 | 标量类} 逐格证据判定（§3.4），证据引用入行",
        "任一失败": "不计时",
    }
    if op == "product_reduce":
        plan.update({
            "验 ①": f"我方整数核 vs 独立 ZERO-MODEL scalar-ref byte-exact → 失败 = {VOID_OURS_WRONG}",
            "验 ②": "DUT/oracle 双 fault arm 均须 bite；缺一即空心",
            "验 ③": "内部 sub-primitive 无 ggml standalone；对手身份 = 同算术 constructed scalar-ref（标量类）",
            "对手档": "标量类·CHEAP tier；倍率不得称硬赢",
        })
    elif board == "scalar":
        plan.update({
            "验 ③": "真 no-V 部署 generic + owned/deployed zero-vector；仅 dormant contract，不授予 run eligibility",
            "对手档": "标量类·enablement-NONWIN；ISSUE-061/104 未解前不开测",
        })
    if not execute:
        return plan, None

    rc, text = _run_harness(harness, board, "verify", fmt, HARNESS_TIMEOUT_VERIFY)
    if run_dir is not None:
        with guarded_open(os.path.join(run_dir, "verify.stdout.txt"), "w") as fh:
            fh.write(text)
    if rc is None:
        return plan, f"{VOID_OURS_WRONG}(verify harness 超时)"
    if rc != 0:
        # 板端硬失败（build/probe VOID）——归我方错，除非 stdout 明说对手废/派发不符。
        return plan, f"{VOID_OURS_WRONG}(verify harness rc={rc})"
    if "# ALL_DONE" not in text:
        return plan, f"{VOID_OURS_WRONG}(verify 未跑完·无 ALL_DONE)"
    if _cpu_md5_stable(text) is False:
        return plan, f"{VOID_DIRTY_BOARD}(对手库 md5 测量中变身)"

    parser = resolve_verify_parser(op)
    return plan, parser(text, fmt, board, engine)


_GEMM_PREFILL_RE = re.compile(
    r"GEMM_PREFILL fmt=(\S+) .* seed=0x([0-9A-Fa-f]+) \| "
    r"ours_med_ns=(\d+)\(iqr[\d.]+%\) oppG_med_ns=(\d+)\(iqr[\d.]+%\) "
    r"oppX_med_ns=(\d+)\(iqr[\d.]+%\) \| ratio_cold_G=([\d.]+) ratio_cold_X=([\d.]+)"
)


_VECDOT_COLD_RE = re.compile(
    r"# VECDOT_COLD fmt=(\S+) seed=0x([0-9A-Fa-f]+)(?: reps=\d+)? \| "
    r"ours_med_ns=([\d.]+)\(iqr[\d.]+%\) oppX_med_ns=([\d.]+)\(iqr[\d.]+%\) "
    r"\| ratio_cold_X=([\d.]+)"
)

_PRODUCT_COLD_RE = re.compile(
    r"PREDUCE op=(\S+) VLEN=(\d+) .* reps=\d+ seed=0x([0-9A-Fa-f]+) \| .* "
    r"COLD ours_med_ns=([\d.]+) o_iqr=[\d.]+ scal_med_ns=([\d.]+) "
    r"s_iqr=[\d.]+ ratio_cold_med=([\d.]+) ratio_cold_best=[\d.]+ "
    r"\| int_mismatch=(\d+)"
)


def _cold_result(seeds):
    """所有 op 共享的 two-seed 归一化；不接受缺 seed、重复 seed 或默认数。"""
    if [entry["seed"].lower() for entry in seeds] != ["0x1357", "0xace2"]:
        return f"{VOID_DIRTY_BOARD}(measure 缺固定 S1/S2 或顺序漂移)"
    cold_x = seeds[0]["ratio_cold_X"]
    near = is_near_gate(cold_x)
    noise = ""
    if near:
        spread = abs(seeds[0]["ratio_cold_X"] - seeds[1]["ratio_cold_X"])
        noise = (
            f"近门·2seed一致(Δ={spread:.4f})"
            if spread < 0.05 else f"近门·2seed分散(Δ={spread:.4f})"
        )
    return {
        "cold": f"{cold_x:.4f}",
        "cold_x_s1": cold_x,
        "seeds": seeds,
        "near_gate": near,
        "noise": noise,
    }


def _parse_gemm_cold(text, fmt, board, engine):
    if engine != "rvv":
        return f"{VOID_DIRTY_BOARD}(GEMM cold parser identity mismatch)"
    seeds = []
    for match in _GEMM_PREFILL_RE.finditer(text):
        if match.group(1) != fmt:
            return f"{VOID_DIRTY_BOARD}(GEMM measure fmt 漂移: {match.group(1)} != {fmt})"
        seeds.append({
            "seed": "0x" + match.group(2).upper(),
            "ours_med_ns": int(match.group(3)),
            "oppX_med_ns": int(match.group(5)),
            "ratio_cold_G": float(match.group(6)),
            "ratio_cold_X": float(match.group(7)),
        })
    return _cold_result(seeds)


