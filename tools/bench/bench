def guarded_open(path, mode):
    """§3.2.2 测量禁止创建三处目的地以外的任何文件。写路径不在闸内 = 中止，不是警告。"""
    real = os.path.realpath(path)
    allowed = real == os.path.realpath(DEST_RUNSLOG) or real.startswith(
        os.path.realpath(DEST_RUNS) + os.sep
    )
    if not allowed:
        raise SystemExit(
            f"[destination-guard] 拒绝写入 {real}\n"
            f"  §3.2 单一目的地法只许：{DEST_RUNSLOG} · {DEST_RUNS}/<run-id>/\n"
            f"  （主表现址 {MASTER_INTERIM} 的写入 gated on ISSUE-073；"
            f"{DEST_MASTER} 为目标态、禁预先写入。）"
        )
    return open(real, mode, encoding="utf-8")


