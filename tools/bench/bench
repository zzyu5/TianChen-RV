def step1_preflight(board, cfg, execute):
    """静板预飞：载荷阈 · 单实例锁 · 零游离进程 · CPU 状态哈希。不过即 VOID-脏板。

    配方 = run_grid4_p2.sh 的 load gate（/proc/stat 逐核 idle%，阈 70）+ stray（pgrep -x）
    + cpu_md5（libggml-cpu.so 前后比对）。
    """
    plan = {
        "步": "1 · 静板预飞（硬点）",
        "载荷阈": "逐核 /proc/stat idle% ≥ 70（best-core 选核）",
        "单实例锁": f"flock {DEST_RUNS}/.lock（同板同格互斥）",
        "零游离进程": "pgrep -x <bin> == 0（-f 会匹配 ssh 自身命令行，故 -x）",
        "CPU 状态哈希": f"md5sum {cfg['ggml']}/libggml-cpu.so 前后比对 + scaling_governor + loadavg",
        "不过": VOID_DIRTY_BOARD,
    }
    if not execute:
        return plan, None
    idle = _probe_best_core(cfg)
    if idle is None or idle[1] < 70:
        return plan, VOID_DIRTY_BOARD
    return plan, None


def _probe_best_core(cfg):
    """真板探针（干跑不走此路）。返回 (core, idle%) 或 None。"""
    cores = " ".join(str(c) for c in cfg["cores"])
    script = (
        "read_busy(){ awk -v c=\"cpu$1\" '$1==c{idle=$5+$6; "
        "tot=$2+$3+$4+$5+$6+$7+$8; print tot\" \"idle}' /proc/stat; }; "
        f"for c in {cores}; do read t i < <(read_busy $c); echo \"$c $t $i\"; done; sleep 0.5; "
        f"for c in {cores}; do read t i < <(read_busy $c); echo \"$c $t $i\"; done"
    )
    try:
        out = subprocess.run(
            ["ssh", cfg["ssh"], "bash -c " + json.dumps(script)],
            capture_output=True, text=True, timeout=60,
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    if out.returncode != 0:
        return None
    rows = [ln.split() for ln in out.stdout.splitlines() if ln.strip()]
    half = len(rows) // 2
    best = None
    for a, b in zip(rows[:half], rows[half:]):
        dt, di = int(b[1]) - int(a[1]), int(b[2]) - int(a[2])
        pct = (100 * di // dt) if dt > 0 else 0
        if best is None or pct > best[1]:
            best = (int(a[0]), pct)
    return best


def step2_lineage(board, cfg, execute):
    """双方板端 clang-18 构建 —— 我方与对手同链同板；世系（板·链·批次）自动入行。

    §Quality Check：验收【查世系不查字样】⟹ 世系 = 探针读数三元，不是构建脚本里的字符串。
    """
    plan = {
        "步": "2 · 双方板端 clang-18 构建（硬点：世系）",
        "我方链": f"{cfg['cc']} -march={cfg['march']} {cfg['cflags']} {cfg['ldextra']}".strip(),
        "对手链": f"同链同板（对手 = {cfg['ggml']} 的板端 clang-18 构建）",
        "世系三元": "{板 = uname -m/-r + /proc/cpuinfo isa · 链 = $CC --version 实读 · 批次 = ggml pin + so 的 md5}",
        "gcc": "§3.6：gcc 不存在 —— --gcc-install-dir 是 clang 的 CRT 定位器，非 gcc 构建",
    }
    if not execute:
        return plan, None
    return plan, _probe_lineage(cfg)


def _probe_lineage(cfg):
    """真板探针（干跑不走此路）。世系 = {板·链·批次} 的实读三元。"""
    script = (
        f"{cfg['envsrc']} echo BOARD=$(uname -m)/$(uname -r); "
        f"echo CHAIN=$({cfg['cc']} --version | head -1); "
        f"echo BATCH=$(md5sum {cfg['ggml']}/libggml-cpu.so | cut -d' ' -f1)"
    )
    try:
        out = subprocess.run(
            ["ssh", cfg["ssh"], script], capture_output=True, text=True, timeout=60
        )
    except (subprocess.TimeoutExpired, OSError):
        return None
    if out.returncode != 0:
        return None
    triple = dict(
        ln.split("=", 1) for ln in out.stdout.splitlines() if "=" in ln
    )
    return "·".join(triple.get(k, "?") for k in ("BOARD", "CHAIN", "BATCH"))


